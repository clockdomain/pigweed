// ASPEED AST1030 Executor test configuration
// ARM Cortex-M4 @ 200 MHz with 768KB SRAM (0x00000000 - 0x000BFFFF)
// NOTE: AST1030 does not support XIP - ROM code copies firmware from flash to RAM
// and executes from RAM starting at 0x00000000
//
// PMSAv7-Friendly Memory Layout (single app):
//   0x00000000 - 0x00000500: Vector table (1280 bytes)
//   0x00000500 - 0x00020000: Kernel code (~126KB, ends at 128KB boundary)
//   0x00020000 - 0x00040000: Executor app code (128KB, power-of-2 aligned)
//   0x00040000 - 0x00060000: Kernel RAM (128KB, power-of-2 aligned)
//   0x00060000 - 0x00068000: App RAM (32KB)
//
// Total: 416KB, fits within AST1030's 768KB SRAM.
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1280,  // 0x500
    },
    kernel: {
        flash_start_address: 0x00000500,  // After vector table
        flash_size_bytes: 129792,         // ~126KB (ends at 0x00020000)
        ram_start_address: 0x00040000,    // After app flash (power-of-2 aligned)
        ram_size_bytes: 131072,           // 128KB
    },
    apps: [
        {
            name: "executor_test",
            flash_size_bytes: 131072,     // 128KB (power-of-2 aligned)
            ram_size_bytes: 32768,        // 32KB
            process: {
                name: "executor process",
                objects: [],
                threads: [
                    {
                        name: "executor thread",
                        stack_size_bytes: 2048,  // 2KB stack
                    },
                ],
            },
        },
    ],
}
