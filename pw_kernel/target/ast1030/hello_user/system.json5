// Minimal single-app configuration for AST1030 hello user mode test
// ARM Cortex-M4 @ 200 MHz with 768KB SRAM (0x00000000 - 0x000BFFFF)
//
// PMSAv7-Friendly Memory Layout:
// For PMSAv7 compatibility, regions must be at power-of-2 aligned addresses.
//
//   0x00000000 - 0x00000420: Vector table (1056 bytes)
//   0x00000420 - 0x00020000: Kernel code (~126KB, ends at 128KB boundary)
//   0x00020000 - 0x00040000: Hello app code (128KB, power-of-2 aligned)
//   0x00040000 - 0x00060000: Kernel RAM (128KB, power-of-2 aligned)
//   0x00060000 - 0x00070000: Hello app RAM (64KB)
//
// Total: 448KB, fits within AST1030's 768KB SRAM.
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1056,  // 0x420
    },
    kernel: {
        flash_start_address: 0x00000420,  // After vector table
        flash_size_bytes: 130016,         // ~126KB (ends at 0x00020000, power-of-2 boundary)
        ram_start_address: 0x00040000,    // After app flash (power-of-2 aligned)
        ram_size_bytes: 131072,           // 128KB
    },
    apps: [
        {
            name: "hello",
            flash_size_bytes: 131072,     // 128KB (power-of-2 aligned)
            ram_size_bytes: 65536,        // 64KB
            process: {
                name: "hello process",
                objects: [
                    {
                        name: "TEST_CHANNEL",
                        type: "channel_handler",
                    },
                ],
                threads: [
                    {
                        name: "hello thread",
                        stack_size_bytes: 2048,  // 2KB stack
                    },
                ],
            },
        },
    ],
}
