// TI Stellaris LM3S6965 IPC test configuration
// ARM Cortex-M3 @ 50 MHz with 256KB Flash and 64KB SRAM
// Flash: 0x00000000 - 0x0003FFFF (256KB)
// SRAM:  0x20000000 - 0x2000FFFF (64KB)
//
// PMSAv7-Friendly Memory Layout:
// The system generator places app flash after kernel flash, and app RAM after
// kernel RAM. For PMSAv7 compatibility, regions must be at power-of-2 aligned
// addresses to avoid MPU subregion overlap with kernel RAM.
//
// Flash Layout (256KB total):
//   0x00000000 - 0x00000420: Vector table (1056 bytes)
//   0x00000420 - 0x00010000: Kernel code (~62KB, ends at 64KB boundary)
//   0x00010000 - 0x00028000: Initiator app code (96KB)
//   0x00028000 - 0x00040000: Handler app code (96KB)
//
// SRAM Layout (64KB total at 0x20000000):
//   0x20000000 - 0x20008000: Kernel RAM (32KB)
//   0x20008000 - 0x2000C000: Initiator RAM (16KB)
//   0x2000C000 - 0x20010000: Handler RAM (16KB)
//
// Total Flash: 256KB, Total SRAM: 64KB - fits LM3S6965
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1056,  // 0x420
    },
    kernel: {
        flash_start_address: 0x00000420,  // After vector table
        flash_size_bytes: 64480,          // ~62KB (ends at 0x00010000, 64KB boundary)
        ram_start_address: 0x20000000,    // SRAM starts at 0x20000000 for LM3S6965
        ram_size_bytes: 32768,            // 32KB for kernel
    },
    apps: [
        {
            name: "initiator",
            flash_size_bytes: 98304,      // 96KB for initiator app
            ram_size_bytes: 16384,        // 16KB RAM for initiator
            process: {
                name: "initiator process",
                objects: [
                    {
                        name: "IPC",
                        type: "channel_initiator",
                        handler_app: "handler",
                        handler_object_name: "IPC",
                    }
                ],
                threads: [
                    {
                        name: "initiator thread",
                        stack_size_bytes: 2048,  // 2KB stack
                    },
                ],
            },
        },
        {
            name: "handler",
            flash_size_bytes: 98304,      // 96KB for handler app
            ram_size_bytes: 16384,        // 16KB RAM for handler
            process: {
                name: "handler process",
                objects: [
                    {
                        name: "IPC",
                        type: "channel_handler",
                    },
                ],
                threads: [
                    {
                        name: "handler thread",
                        stack_size_bytes: 2048,  // 2KB stack
                    },
                ],
            },
        },
    ],
}
