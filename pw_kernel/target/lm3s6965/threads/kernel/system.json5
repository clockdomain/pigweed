// LM3S6965 Kernel Threading Test Configuration
// ARM Cortex-M3 @ 50 MHz (simulated at 12 MHz for QEMU SysTick)
// 256KB Flash, 64KB SRAM
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1280,  // 0x500 (320 vectors)
    },
    kernel: {
        flash_start_address: 0x00000500,  // After vector table
        flash_size_bytes: 262144,         // 256KB for kernel code
        ram_start_address: 0x20000000,    // SRAM starts at 0x20000000 for LM3S6965
        ram_size_bytes: 65536,            // 64KB SRAM
    },
}
