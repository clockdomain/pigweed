// STM32F407 Discovery IPC test configuration
// ARM Cortex-M4 @ 168 MHz with 1MB Flash and 192KB SRAM
//
// Memory Map:
// Flash: 0x08000000 - 0x080FFFFF (1MB)
// SRAM1: 0x20000000 - 0x2001BFFF (112KB)
// SRAM2: 0x2001C000 - 0x2001FFFF (16KB)
// CCM:   0x10000000 - 0x1000FFFF (64KB, not used - no DMA access)
//
// Using SRAM1 + SRAM2 = 128KB contiguous at 0x20000000
//
// PMSAv7-Friendly Memory Layout:
// Flash Layout (using first 512KB):
//   0x08000000 - 0x08000500: Vector table (~1.25KB)
//   0x08000500 - 0x08020000: Kernel code (~126KB)
//   0x08020000 - 0x08040000: Initiator app code (128KB)
//   0x08040000 - 0x08060000: Handler app code (128KB)
//
// SRAM Layout (128KB total at 0x20000000):
//   0x20000000 - 0x20010000: Kernel RAM (64KB)
//   0x20010000 - 0x20018000: Initiator RAM (32KB)
//   0x20018000 - 0x20020000: Handler RAM (32KB)
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x08000000,
        vector_table_size_bytes: 1280,  // 0x500
    },
    kernel: {
        flash_start_address: 0x08000500,  // After vector table
        flash_size_bytes: 129792,         // 0x1FB00, ends exactly at 0x08020000
        ram_start_address: 0x20000000,
        ram_size_bytes: 65536,            // 64KB for kernel
    },
    apps: [
        {
            name: "initiator",
            flash_size_bytes: 131072,     // 128KB for initiator app
            ram_size_bytes: 32768,        // 32KB RAM for initiator
            process: {
                name: "initiator process",
                objects: [
                    {
                        name: "IPC",
                        type: "channel_initiator",
                        handler_app: "handler",
                        handler_object_name: "IPC",
                    }
                ],
                threads: [
                    {
                        name: "initiator thread",
                        stack_size_bytes: 4096,  // 4KB stack
                    },
                ],
            },
        },
        {
            name: "handler",
            flash_size_bytes: 131072,     // 128KB for handler app
            ram_size_bytes: 32768,        // 32KB RAM for handler
            process: {
                name: "handler process",
                objects: [
                    {
                        name: "IPC",
                        type: "channel_handler",
                    },
                ],
                threads: [
                    {
                        name: "handler thread",
                        stack_size_bytes: 4096,  // 4KB stack
                    },
                ],
            },
        },
    ],
}
