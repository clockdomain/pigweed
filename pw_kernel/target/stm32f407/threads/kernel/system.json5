// STM32F407 Discovery Kernel Threading Test Configuration
// ARM Cortex-M4 @ 168 MHz with 1MB Flash and 192KB SRAM
//
// Memory Map:
// Flash: 0x08000000 - 0x080FFFFF (1MB)
// SRAM1: 0x20000000 - 0x2001BFFF (112KB)
// SRAM2: 0x2001C000 - 0x2001FFFF (16KB)
// CCM:   0x10000000 - 0x1000FFFF (64KB, not used - no DMA access)
//
// Kernel-only test (no apps), so we use the full SRAM1+SRAM2 = 128KB.
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x08000000,
        vector_table_size_bytes: 1280,  // 0x500
    },
    kernel: {
        flash_start_address: 0x08000500,  // After vector table
        flash_size_bytes: 524032,         // ~512KB for kernel code (0x7FB00)
        ram_start_address: 0x20000000,
        ram_size_bytes: 131072,           // 128KB (full SRAM1+SRAM2)
    },
}
